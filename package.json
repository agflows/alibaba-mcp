{
  "name": "alibaba-mcp",
  "version": "0.1.3",
  "description": "Local Chrome extension and MCP server for controlled access to your Alibaba messages.",
  "type": "module",
  "bin": {
    "alibaba-mcp": "dist/server/index.js",
    "alibaba-mcp-setup": "dist/installer/index.js"
  },
  "files": [
    "dist/server",
    "dist/installer",
    "dist/extension",
    "README.md",
    "SECURITY.md",
    "PRIVACY.md",
    "STORE_LISTING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "pretest": "node scripts/build-test.mjs",
    "test": "node --import ./scripts/dom-rect-list-shim.mjs --test test/*.test.mjs",
    "check": "tsc --noEmit && npm test && npm run build",
    "start": "node dist/server/index.js",
    "prepare": "node scripts/build.mjs",
    "package:extension": "npm run build && node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.11",
    "fflate": "^0.8.3",
    "jsdom": "^27.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true
}
